{
  "name": "web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "apps/clients/web" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "apps/clients/web" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test", "cwd": "apps/clients/web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "apps/clients/web" }
    }
  }
}
