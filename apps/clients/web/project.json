{
  "name": "web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec eslint .", "cwd": "apps/clients/web" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit", "cwd": "apps/clients/web" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vitest run", "cwd": "apps/clients/web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vite build", "cwd": "apps/clients/web" }
    }
  }
}
